# Local development only. In Cloud Run, MONGO_URI and GEMINI_API_KEY come from Secret Manager.
ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=dietary_insight
# From Google AI Studio, on a project WITH billing enabled (UK users require the paid tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_S=75
DAILY_AI_CALL_CAP=500
ANALYSIS_VERSION=2026-10
